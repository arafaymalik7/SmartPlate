generator client {
  provider = "prisma-client"
  output = "../src/generated/prisma"
}
datasource db {
 provider = "postgresql"
}
enum UserRole {
 ADMIN
}
enum PublicationStatus {
 DRAFT
 PUBLISHED
 ARCHIVED
}
enum SourceType {
 ILLUSTRATIVE
 FOOD_COMPOSITION_DERIVED
 RESTAURANT_VERIFIED
}
enum DisclosureState {
 PRESENT
 ABSENT_VERIFIED
 UNKNOWN
}
model User {
 id String @id @default(cuid())
 email String @unique
 passwordHash String
 role UserRole @default(ADMIN)
 sessions Session[]
 auditLogs AdminAuditLog[]
}
model Session {
 id String @id @default(cuid())
 token String @unique
 userId String
 expiresAt DateTime
 user User @relation(fields:[userId],references:[id],onDelete:Cascade)
}
model Restaurant {
 id String @id @default(cuid())
 slug String @unique
 name String
 cuisine String
 location String
 description String
 status PublicationStatus @default(DRAFT)
 imageUrl String?
 categories MenuCategory[]
 items MenuItem[]
}
model MenuCategory {
 id String @id @default(cuid())
 restaurantId String
 name String
 slug String
 restaurant Restaurant @relation(fields:[restaurantId],references:[id],onDelete:Cascade)
 items MenuItem[]
 @@unique([restaurantId,slug])
}
model MenuItem {
 id String @id @default(cuid())
 restaurantId String
 categoryId String?
 slug String @unique
 name String
 description String
 price Decimal @db.Decimal(10,2)
 currency String @default("MYR")
 servingSize String
 status PublicationStatus @default(DRAFT)
 isAvailable Boolean @default(true)
 dietaryStatus String?
 restaurant Restaurant @relation(fields:[restaurantId],references:[id],onDelete:Cascade)
 category MenuCategory? @relation(fields:[categoryId],references:[id],onDelete:SetNull)
 nutrition MenuItemNutrition?
 ingredients MenuItemIngredient[]
 allergens MenuItemAllergen[]
}
model MenuItemNutrition {
 id String @id @default(cuid())
 menuItemId String @unique
 calories Decimal? @db.Decimal(10,2)
 proteinG Decimal? @db.Decimal(10,2)
 carbsG Decimal? @db.Decimal(10,2)
 fatG Decimal? @db.Decimal(10,2)
 sodiumMg Decimal? @db.Decimal(10,2)
 sugarG Decimal? @db.Decimal(10,2)
 fiberG Decimal? @db.Decimal(10,2)
 sourceType SourceType @default(ILLUSTRATIVE)
 sourceUrl String?
 sourceCitation String?
 reviewedAt DateTime?
 menuItem MenuItem @relation(fields:[menuItemId],references:[id],onDelete:Cascade)
}
model Ingredient {
 id String @id @default(cuid())
 name String @unique
 uses MenuItemIngredient[]
}
model MenuItemIngredient {
 menuItemId String
 ingredientId String
 state DisclosureState @default(UNKNOWN)
 menuItem MenuItem @relation(fields:[menuItemId],references:[id],onDelete:Cascade)
 ingredient Ingredient @relation(fields:[ingredientId],references:[id],onDelete:Restrict)
 @@id([menuItemId,ingredientId])
}
model Allergen {
 id String @id @default(cuid())
 name String @unique
 uses MenuItemAllergen[]
}
model MenuItemAllergen {
 menuItemId String
 allergenId String
 state DisclosureState @default(UNKNOWN)
 menuItem MenuItem @relation(fields:[menuItemId],references:[id],onDelete:Cascade)
 allergen Allergen @relation(fields:[allergenId],references:[id],onDelete:Restrict)
 @@id([menuItemId,allergenId])
}
model AdminAuditLog {
 id String @id @default(cuid())
 actorId String
 action String
 entityType String
 entityId String
 metadata Json?
 createdAt DateTime @default(now())
 actor User @relation(fields:[actorId],references:[id],onDelete:Restrict)
}
