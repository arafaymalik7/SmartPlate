# Required for CP-03 onward. Use a non-production PostgreSQL database locally.
DATABASE_URL="postgresql://smartplate:change-me@localhost:5432/smartplate?schema=public"
# Direct connection used by Prisma migrations for a hosted provider.
DIRECT_URL="postgresql://smartplate:change-me@localhost:5432/smartplate?schema=public"
# Set a long random secret per environment; never commit a real value.
AUTH_SECRET="replace-with-a-long-random-secret"
ADMIN_BOOTSTRAP_EMAIL="admin@example.invalid"
ADMIN_BOOTSTRAP_PASSWORD="replace-with-a-strong-unique-password"
